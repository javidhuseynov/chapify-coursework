# Copy this file to .env (never commit .env) and replace the placeholder values.
# Command Prompt:  copy .env.example .env

# Django secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
CHAPIFY_SECRET_KEY=<paste-a-long-random-value>

# True for local development, False for any shared/hosted deployment.
CHAPIFY_DEBUG=True

# Comma-separated host names allowed to serve the app.
CHAPIFY_ALLOWED_HOSTS=127.0.0.1,localhost

# Shared secret between Chapify and the payment gateway (HMAC-SHA256).
# Generate one the same way as the secret key.
CHAPIFY_PAYMENT_GATEWAY_SECRET=<paste-another-long-random-value>

# Unpaid requests and abandoned uploads are removed after this many hours
# by "python manage.py cleanup_documents".
CHAPIFY_DOCUMENT_RETENTION_HOURS=24
