# Copy this file to .env (never commit .env) and replace the placeholder values.
# Command Prompt:  copy .env.example .env

# Django secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
CHAPIFY_SECRET_KEY=<paste-a-long-random-value>

# True for local development, False for any shared/hosted deployment.
CHAPIFY_DEBUG=True

# Comma-separated host names allowed to serve the app.
CHAPIFY_ALLOWED_HOSTS=127.0.0.1,localhost

# Payment gateway: chapify_pay (the test gateway in gateway_service/, default) or stripe.
CHAPIFY_PAYMENT_GATEWAY=chapify_pay

# Chapify Pay. gateway_service reads this same file, so both sides use the same values.
# Generate each value the same way as the secret key, keeping the prefixes.
CHAPIFY_PAY_URL=http://127.0.0.1:8001
CHAPIFY_PAY_API_KEY=sk_test_<paste-a-long-random-value>
CHAPIFY_PAY_WEBHOOK_SECRET=whsec_<paste-another-long-random-value>
CHAPIFY_PAY_WEBHOOK_URL=http://127.0.0.1:8000/payments/webhook/
CHAPIFY_PAY_SECRET_KEY=<django-secret-key-for-the-gateway>

# Stripe, only with CHAPIFY_PAYMENT_GATEWAY=stripe. TEST keys only (sk_test_...);
# live keys are refused. The webhook secret comes from "stripe listen" or the Stripe dashboard.
CHAPIFY_STRIPE_SECRET_KEY=
CHAPIFY_STRIPE_WEBHOOK_SECRET=

# Unpaid requests and abandoned uploads are removed after this many hours
# by "python manage.py cleanup_documents".
CHAPIFY_DOCUMENT_RETENTION_HOURS=24

# Login lockout: failed attempts per username + IP address, and lockout duration in seconds.
CHAPIFY_LOGIN_FAILURE_LIMIT=5
CHAPIFY_LOGIN_LOCKOUT_SECONDS=900

# Lifetime of API tokens (mobile app, scripts) in hours. Default 168 = 7 days.
CHAPIFY_API_TOKEN_TTL_HOURS=168

# Only for a hosted deployment behind HTTPS (with DEBUG off): secure cookies, HTTPS redirect, HSTS.
CHAPIFY_HTTPS=False
